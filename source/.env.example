# Local Docker development only. Replace this value outside local review environments.
DB_PASSWORD=replace-with-a-local-development-password

# Optional AI-assisted PDF extraction. The Typhoon API key belongs only in
# ai-gateway/.dev.vars or Cloudflare Worker Secrets, never in this file.
AI_GATEWAY_URL=http://host.docker.internal:8787
AI_GATEWAY_TOKEN=replace-with-the-same-backend-token-used-by-the-worker
